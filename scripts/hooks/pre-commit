#!/usr/bin/env bash
# Refuse to commit anything that must never leave this machine.
#
# CI scans for secrets too, but CI runs after a push, and a token that reached
# GitHub is burned whether or not the build goes red. This hook is the only
# check that runs while the damage is still undoable.
#
# Installed by scripts/install-hooks.sh (and by setup.sh --dev). Bypassing it
# with --no-verify is possible and occasionally right; doing it for one of the
# paths below never is.
set -euo pipefail

die() { printf '\033[31mpre-commit:\033[0m %s\n' "$1" >&2; exit 1; }

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# These are gitignored, so reaching this hook means someone typed `git add -f`
# or the ignore rule regressed. Both are worth stopping for.
blocked="$(printf '%s\n' "$staged" | grep -E \
  '(^|/)\.env($|\.)|(^|/)skill/postflight/state/|\.local\.md$|(^|/)skill/postflight/settings\.json$' || true)"

if [ -n "$blocked" ]; then
  printf '\033[31mpre-commit:\033[0m these paths must never be committed:\n' >&2
  printf '%s\n' "$blocked" | sed 's/^/  /' >&2
  printf '\nThey hold credentials, your Telegram user id, or your own posts.\n' >&2
  printf 'Unstage them with: git restore --staged <path>\n' >&2
  exit 1
fi

# The manifest and the skill folder have to move together, or the next publish
# fails in CI instead of here.
if printf '%s\n' "$staged" | grep -q '^skill/postflight/'; then
  manifest_root="$(git rev-parse --show-toplevel)/scripts/clawhub-manifest.txt"
  if [ -f "$manifest_root" ]; then
    allowed="$(grep -vE '^[[:space:]]*(#|$)' "$manifest_root" | LC_ALL=C sort)"
    added="$(printf '%s\n' "$staged" | grep '^skill/postflight/' | sed 's|^skill/postflight/||')"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      printf '%s\n' "$allowed" | grep -qxF "$f" \
        || die "$f is not in scripts/clawhub-manifest.txt — add it there if it should ship to ClawHub"
    done <<< "$added"
  fi
fi

# The same check CI's publish guard runs, moved to where it is cheapest to
# fix. A skill doc pointing at {baseDir}/state tells the agent to write into
# the folder the next upgrade deletes, so it is a live bug, not a stale doc.
skill_files="$(printf '%s\n' "$staged" | grep '^skill/postflight/' || true)"
if [ -n "$skill_files" ]; then
  stale="$(printf '%s\n' "$skill_files" | tr '\n' '\0' \
    | xargs -0 grep -ln -e '{baseDir}/state' \
                       -e '{baseDir}/pillars.local.md' \
                       -e '{baseDir}/voice-examples.local.md' 2>/dev/null || true)"
  if [ -n "$stale" ]; then
    printf '\033[31mpre-commit:\033[0m these still point at the pre-v1.2.0 state paths:\n' >&2
    printf '%s\n' "$stale" | sed 's/^/  /' >&2
    printf '\nState lives in <workspace>/postflight-state now. See SKILL.md\n' >&2
    printf '"Where things live".\n' >&2
    exit 1
  fi
fi

# Belt and braces: content-level scan of the staged diff, when available.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner \
    --config "$(git rev-parse --show-toplevel)/.gitleaks.toml" \
    || die "gitleaks found a secret in the staged diff (value redacted above)"
fi

exit 0
